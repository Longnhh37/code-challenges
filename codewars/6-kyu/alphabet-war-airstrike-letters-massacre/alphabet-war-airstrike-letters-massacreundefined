fn alphabet_war(fight: &str) -> &'static str {
    let mut pow = [0i32; 26];
    pow[(b'w' - b'a') as usize] = 4;
    pow[(b'p' - b'a') as usize] = 3;
    pow[(b'b' - b'a') as usize] = 2;
    pow[(b's' - b'a') as usize] = 1;
    pow[(b'm' - b'a') as usize] = -4;
    pow[(b'q' - b'a') as usize] = -3;
    pow[(b'd' - b'a') as usize] = -2;
    pow[(b'z' - b'a') as usize] = -1;
    
    let mut bytes: Vec<u8> = fight.bytes().collect();
    let mut i = 0;
    while i < bytes.len() {
        if bytes[i] == b'*' {
            if i > 0 {
                bytes[i - 1] = b'_';
            }   
            i += 1;
            while i < bytes.len() && bytes[i] == b'*' {
                i += 1;
            }
            if i >= bytes.len() {
                break;
            }
            bytes[i] = b'_';
        }
        i += 1;
    }
    
    let mut total = 0;
    for b in bytes {
        if b.is_ascii_alphabetic() {
            total += pow[(b - b'a') as usize];
        }
    }
    if total > 0 {
        "Left side wins!"
    } else if total < 0 {
        "Right side wins!"
    } else {
        "Let's fight again!"
    }
}   
